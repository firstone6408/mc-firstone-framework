{
	"schemaVersion": 1,
	"id": "firstone-framework",
	"version": "${version}",
	"name": "FirstOne Framework",
	"description": "Brings back the feel of Minecraft 1.7.10 on Fabric 1.21.1: legacy animations, 1.7.10 knockback, hitboxes, drops and boats, pre-1.9 combat, the 1.7.10 HUD, your own cosmetic effects, resource pack presets, endermen that leave blocks in place, piglins and hoglins that stay off lit Nether paths and game window tweaks. Every feature is a separate module with its own in-game settings.",
	"authors": [
		{
			"name": "firstone6408",
			"contact": {
				"homepage": "https://github.com/firstone6408"
			}
		}
	],
	"contact": {
		"homepage": "https://github.com/firstone6408/mc-firstone-framework",
		"sources": "https://github.com/firstone6408/mc-firstone-framework",
		"issues": "https://github.com/firstone6408/mc-firstone-framework/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/firstone-framework/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.firstone.framework.FirstOneFramework"
		],
		"client": [
			"io.github.firstone.framework.client.FirstOneFrameworkClient"
		],
		"server": [
			"io.github.firstone.framework.FirstOneFrameworkDedicatedServer"
		],
		"modmenu": [
			"io.github.firstone.framework.client.ModMenuApiImpl"
		]
	},
	"mixins": [
		"firstone-framework.mixins.json",
		{
			"config": "firstone-framework.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.github_releases": "https://github.com/firstone6408/mc-firstone-framework/releases"
			}
		}
	}
}